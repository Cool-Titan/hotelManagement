# Copy to .env and fill in. Never commit real values.

# Postgres. On Neon use the pooled URL for DATABASE_URL and the direct URL for DIRECT_URL.
DATABASE_URL="postgresql://kaapi:kaapi-local@127.0.0.1:54329/kaapi"
DIRECT_URL="postgresql://kaapi:kaapi-local@127.0.0.1:54329/kaapi"

# 32+ random characters: node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
SESSION_SECRET=""

# Shared secret that simulated email/WhatsApp webhooks must send (x-webhook-secret header).
INBOUND_WEBHOOK_SECRET=""

# AI provider. Gemini is used if GEMINI_API_KEY is set, else xAI Grok if XAI_API_KEY is set.
# Leave both empty to run with the rule-based fallback classifier.
GEMINI_API_KEY=""
GEMINI_MODEL="gemini-3.5-flash-lite,gemini-3.1-flash-lite"
XAI_API_KEY=""
XAI_MODEL="grok-4-fast-non-reasoning"

# Password given to the seeded demo accounts.
SEED_DEMO_PASSWORD=""
